<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: camera must be declared explicitly. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Not sandboxed: posting ⌘V / keystrokes into other apps and launching the local
	     Python backend are not possible from the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
